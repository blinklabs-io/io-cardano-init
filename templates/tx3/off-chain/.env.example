# Tx3 off-chain (Gift Card) — environment.
#
# Copy to .env.local (gitignored) and fill in for the interactive CLI. The e2e
# tests DON'T use this file — they boot their own throwaway Dolos devnet.
#
# Tx3 talks to a TRP endpoint (Dolos or Demeter). Unlike the Blockfrost-based
# off-chain tools, it does NOT use the project's INDEXER_URL / Yaci devnet.
#
#   • TRP_URL set    → the CLI resolves/submits against that endpoint.
#   • TRP_URL absent → the CLI errors with guidance (start a Dolos devnet:
#                      `just dev`, which serves TRP on http://localhost:8164).

# TRP endpoint (resolve/submit). Default matches a local `trix devnet`.
TRP_URL=http://localhost:8164

# minibf (Blockfrost-mini) endpoint for chain queries — the CLI uses it to pick a
# seed UTxO and find the locked gift card. `trix devnet` serves it on :3164.
MINIBF_URL=http://localhost:3164

# Signing key for the Owner party, as raw hex (ed25519). Use a throwaway test
# wallet — never commit a real key.
OWNER_ADDRESS=
OWNER_PRIVATE_KEY=
